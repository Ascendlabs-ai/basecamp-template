node_modules/
.next/
dist/
build/
.DS_Store
Thumbs.db

# Local agent/tooling scratch. Harmless if you use none of it.
scratchpad/
.claude/settings.local.json

# Safety-net runtime state, written by the hooks in .claude/. Generated for you;
# never commit it. The hooks resolve these from .claude/ itself (see
# .claude/hooks/shared.mjs), so the paths are exact, not a guess.
.claude/.session-state.json
.claude/.hook-errors.log
.claude/.naysayer-result.json

# Some naysayer implementations write their verdict at the repo ROOT instead of
# in .claude/. The skill shipped here writes no file at all, but a root copy does
# turn up in practice — ignored either way. Tool state, not template content.
.naysayer-result.json

